rules_version = '2';

// Règles de sécurité de « Ma ZP » (plusieurs parties).
// À copier dans la console Firebase : Firestore Database → Règles.
// Adresse du super-administrateur : la même que adminEmails dans js/config.js (à changer aux deux endroits).
// MAX_PARTIES (ici 3) doit correspondre à maxPartiesParJoueur dans js/config.js.

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }
    function superAdmin() { return signedIn() && request.auth.token.email in ['houben.bryan@gmail.com']; }
    function partie(gid) { return get(/databases/$(database)/documents/parties/$(gid)).data; }
    function master(gid) { return superAdmin() || (signedIn() && partie(gid).owner == request.auth.uid); }
    // Membre : un profil dans la partie, et pas retiré par le maître du jeu.
    function member(gid) { return signedIn() && exists(/databases/$(database)/documents/parties/$(gid)/players/$(request.auth.uid))
      && get(/databases/$(database)/documents/parties/$(gid)/players/$(request.auth.uid)).data.get('retire', false) != true; }
    function st(gid) { return get(/databases/$(database)/documents/parties/$(gid)/state/current).data; }
    function afterDeadline(gid) { return request.time.toMillis() >= st(gid).nextDeadline; }
    // Le tour est calculé par la tâche planifiée (compte de service, hors règles). Un appareil ne peut le calculer
    // qu'en secours, 20 minutes après l'heure limite, si la tâche n'est pas passée.
    function secours(gid) { return request.time.toMillis() >= st(gid).nextDeadline + 20 * 60000; }
    function currentTurn(gid, season, turn) { return season == st(gid).season && turn == st(gid).turn; }
    function pastTurn(gid, season, turn) {
      return season < st(gid).season || (season == st(gid).season && turn < st(gid).turn);
    }

    // Liste des parties d'un joueur, et nombre de parties qu'il a créées.
    match /users/{uid} {
      allow read: if signedIn() && (request.auth.uid == uid || superAdmin());
      allow create: if signedIn() && request.auth.uid == uid
        && request.resource.data.get('possedees', 0) <= 3;
      allow update: if signedIn() && request.auth.uid == uid
        && request.resource.data.get('possedees', 0) <= 3
        && request.resource.data.get('possedees', 0) >= resource.data.get('possedees', 0);
    }

    // Codes d'invitation : on peut lire un code qu'on connaît, pas lister les codes.
    match /codes/{code} {
      allow get: if signedIn();
      allow list: if superAdmin();
      allow create: if signedIn() && request.resource.data.owner == request.auth.uid;
      allow delete: if superAdmin();
    }

    match /parties/{gid} {
      allow get: if signedIn();
      allow list: if superAdmin();
      allow create: if signedIn() && request.resource.data.owner == request.auth.uid
        && request.resource.data.nom is string && request.resource.data.nom.size() > 0 && request.resource.data.nom.size() <= 40
        && getAfter(/databases/$(database)/documents/users/$(request.auth.uid)).data.possedees <= 3;
      allow update: if master(gid) && request.resource.data.owner == resource.data.owner;
      allow delete: if superAdmin();

      // État de la partie : un seul document.
      match /state/{doc} {
        // Lisible par qui connaît la partie (via son code), pour pouvoir s'y inscrire.
        allow read: if signedIn();
        allow create, delete: if master(gid);
        allow update: if master(gid)
          // Résolution d'un tour : uniquement après l'heure limite, et le tour doit avancer.
          // Le tour avance d'exactement un cran (ou la saison change), l'échéance suivante reste proche,
          // et la version minimale du jeu ne recule jamais.
          || (member(gid) && secours(gid)
              && request.resource.data.nextDeadline > resource.data.nextDeadline
              && request.resource.data.nextDeadline <= request.time.toMillis() + 3 * 86400000
              && request.resource.data.get('minClientVersion', 0) >= resource.data.get('minClientVersion', 0)
              && ((request.resource.data.season == resource.data.season && request.resource.data.turn == resource.data.turn + 1)
                  || (request.resource.data.season == resource.data.season + 1 && request.resource.data.turn == 1)))
          // Inscription : un joueur ne peut ajouter que sa propre zone, tant que la partie n'est pas complète (40 zones).
          || (member(gid)
              && request.resource.data.zones.size() <= 40
              && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['zones'])
              && request.resource.data.zones.diff(resource.data.zones).affectedKeys().hasOnly([request.auth.uid])
              && !(request.auth.uid in resource.data.zones)
              // Zone de départ : pas plus que les ressources de départ (60 000 € de budget, 40 agents au plus).
              && request.resource.data.zones[request.auth.uid].budget <= 60
              && request.resource.data.zones[request.auth.uid].agents <= 40
              && request.resource.data.zones[request.auth.uid].uid == request.auth.uid
              // Couleur affichée chez tout le monde avant le tour de 20:00 : une vraie couleur (#RRGGBB).
              && request.resource.data.zones[request.auth.uid].couleur is string
              && request.resource.data.zones[request.auth.uid].couleur.matches('^#[0-9A-Fa-f]{6}$'));
      }

      // Profils des joueurs de cette partie (code, nom et couleur de zone).
      match /players/{uid} {
        allow read: if member(gid) || master(gid);
        // Un joueur ne peut pas annuler son retrait par le maître du jeu, et sa couleur est une vraie couleur (#RRGGBB).
        allow create, update: if master(gid) || (signedIn() && request.auth.uid == uid
          && request.resource.data.nom is string && request.resource.data.nom.size() > 0 && request.resource.data.nom.size() <= 24
          && request.resource.data.code is string && request.resource.data.code.matches('^[0-9]{4}$')
          && (!('pseudo' in request.resource.data) || (request.resource.data.pseudo is string && request.resource.data.pseudo.size() <= 24))
          && (!('couleur' in request.resource.data) || (request.resource.data.couleur is string && request.resource.data.couleur.matches('^#[0-9A-Fa-f]{6}$')))
          // Portrait du chef : un identifiant de portrait (p01 à p99), affiché chez tout le monde.
          && (!('chef' in request.resource.data) || (request.resource.data.chef is map
              && (!('portrait' in request.resource.data.chef) || (request.resource.data.chef.portrait is string && request.resource.data.chef.portrait.matches('^p[0-9]{2}$')))))
          && request.resource.data.get('retire', false) == (resource == null ? false : resource.data.get('retire', false)));
        allow delete: if master(gid);
      }

      // Carnet d'enquête (tableau, marques, notes) : chaque joueur lit et écrit seulement le sien.
      match /carnets/{uid} {
        allow read: if member(gid) && request.auth.uid == uid;
        allow create, update: if member(gid) && request.auth.uid == uid
          && request.resource.data.keys().hasOnly(['affaires', 'maj'])
          && request.resource.data.affaires is map && request.resource.data.affaires.size() <= 2;
        allow delete: if master(gid);
      }

	// Ordres : secrets jusqu'à l'heure limite, modifiables uniquement pendant le tour en cours.
    	  match /orders/{id} {
        // Lire un ordre précis : le sien (même pas encore créé), ou celui des autres après l'heure limite.
        allow get: if member(gid) && (resource == null
          || resource.data.uid == request.auth.uid
          || afterDeadline(gid) || pastTurn(gid, resource.data.season, resource.data.turn));
        // Lire tous les ordres d'un tour : seulement au moment de la résolution.
        allow list: if member(gid) && (afterDeadline(gid) || pastTurn(gid, resource.data.season, resource.data.turn));
        allow create, update: if member(gid)
          && request.resource.data.uid == request.auth.uid
          && id == string(request.resource.data.season) + '_' + string(request.resource.data.turn) + '_' + request.auth.uid
          && currentTurn(gid, request.resource.data.season, request.resource.data.turn)
          && !afterDeadline(gid);
        allow delete: if master(gid);
      }

      // Quêtes du jour : une réponse donnée est définitive, seul le bonus peut être ajouté.
      match /quests/{id} {
        allow read: if member(gid);
        allow update: if member(gid)
          && request.resource.data.uid == request.auth.uid
          && request.resource.data.statut == resource.data.statut
          && request.resource.data.tentatives == resource.data.tentatives
          && !afterDeadline(gid);
        allow create: if member(gid)
          && request.resource.data.uid == request.auth.uid
          && request.resource.data.slot in [0, 1, 2, 3, 4]
          && id == string(request.resource.data.season) + '_' + string(request.resource.data.turn) + '_' + request.auth.uid + '_' + string(request.resource.data.slot)
          && currentTurn(gid, request.resource.data.season, request.resource.data.turn)
          && !afterDeadline(gid);
        allow delete: if master(gid);
      }

      // Gazettes : écrites une seule fois, au moment de la résolution.
      match /gazettes/{id} {
        allow read: if member(gid) || master(gid);
        // Seulement celle du tour qu'on résout, et dans la même transaction que l'état (qui doit avancer) :
        // personne ne peut la créer à l'avance pour bloquer la résolution.
        allow create, update: if master(gid) || (member(gid) && secours(gid)
          && id == string(st(gid).season) + '_' + string(st(gid).turn)
          && (getAfter(/databases/$(database)/documents/parties/$(gid)/state/current).data.turn != st(gid).turn
              || getAfter(/databases/$(database)/documents/parties/$(gid)/state/current).data.season != st(gid).season));
        allow delete: if master(gid);
      }

      // Radio : messages de la partie.
      match /radio/{id} {
        allow read: if member(gid) || master(gid);
        // `at` : l'heure de l'appareil, à 10 minutes près (l'ordre des relances en dépend, et rien ne reste épinglé en tête).
        // Relance d'enchère : seulement avant 20:00, sur la vente en cours, avec un montant.
        allow create: if member(gid) && request.resource.data.uid == request.auth.uid
          && request.resource.data.texte is string
          && request.resource.data.texte.size() > 0 && request.resource.data.texte.size() <= 280
          && request.resource.data.at is number
          && math.abs(request.resource.data.at - request.time.toMillis()) < 600000
          && (!('enchere' in request.resource.data) || (
            request.time.toMillis() < st(gid).nextDeadline
            && request.resource.data.enchere.vente == st(gid).vente.id
            && request.resource.data.enchere.montant is number
            && request.resource.data.enchere.lot in ['a', 'b', 'c']));
        allow delete: if master(gid);
      }

      // Messages privés : seules les deux zones concernées peuvent les lire (pas même le maître du jeu).
      match /prives/{id} {
        allow read: if signedIn() && request.auth.uid in resource.data.participants;
        allow create: if member(gid)
          && request.resource.data.de == request.auth.uid
          && request.resource.data.a is string && request.resource.data.a != request.auth.uid
          && exists(/databases/$(database)/documents/parties/$(gid)/players/$(request.resource.data.a))
          && request.resource.data.participants == [request.auth.uid, request.resource.data.a]
          && request.resource.data.texte is string
          && request.resource.data.texte.size() > 0 && request.resource.data.texte.size() <= 500;
        allow delete: if master(gid);
      }
    }
  }
}
